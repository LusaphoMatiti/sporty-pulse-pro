generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  name                  String?
  password              String?
  emailVerified         DateTime?
  image                 String?
  role                  Role              @default(ATHLETE)
  lastLoginAt           DateTime?
  onboardingComplete    Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  isNewUser             Boolean           @default(true)
  identity              Identity?
  identityAssignedAt    DateTime?
  primaryGoal           PrimaryGoal?
  trainingLocation      TrainingLocation?
  gymTrainingStyle      GymTrainingStyle?
  biologicalSex         BiologicalSex?
  experienceLevel       UserLevel?
  onboardingCompletedAt DateTime?
  privacyPolicyAcceptedAt DateTime?
  purchaseModalShown    Boolean           @default(false)
  accounts              Account[]
  instances             PlanInstance[]
  recoveryLogs          RecoveryLog[]
  sessions              NextAuthSession[]
  subscription          Subscription?
  userEquipment         UserEquipment[]
  workoutLogs           WorkoutLog[]
  scheduledNotification ScheduledNotification []
  notificationPreference NotificationPreference? 
notificationLog NotificationLog []



  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model NextAuthSession {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Equipment {
  id                  String                @id @default(uuid())
  name                String                @unique
  category            String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  exercises           ExerciseEquipment[]
  pendingEntitlements PendingEntitlement[]
  productMappings     ProductEquipmentMap[]
  userEquipment       UserEquipment[]
  workoutPlans        WorkoutPlan[]

  @@map("equipment")
}

model Exercise {
  id               String                 @id @default(uuid())
  name             String                 @unique
  description      String?
  youtubeUrl       String?
  musclesWorked    String[]
  muscleGroup      MuscleGroup
  equipmentId      String?
  impactLevel      ImpactLevel            @default(MEDIUM)
  isBodyweight     Boolean                @default(false)
  thumbnailUrl     String?
  videoUrl         String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  equipment        ExerciseEquipment[]
  substitutions    ExerciseSubstitution[] @relation("OriginalExercise")
  substitutionsFor ExerciseSubstitution[] @relation("SubstituteExercise")
  plannedExercises PlannedExercise[]

  @@index([equipmentId])
  @@map("exercises")
}

model ExerciseEquipment {
  exerciseId  String
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([exerciseId, equipmentId])
  @@map("exercise_equipment")
}

model ExerciseSubstitution {
  id                   String   @id @default(cuid())
  originalExerciseId   String
  substituteExerciseId String
  reason               String
  originalExercise     Exercise @relation("OriginalExercise", fields: [originalExerciseId], references: [id])
  substituteExercise   Exercise @relation("SubstituteExercise", fields: [substituteExerciseId], references: [id])

  @@unique([originalExerciseId, substituteExerciseId])
  @@index([originalExerciseId])
  @@map("exercise_substitutions")
}

model WorkoutPlan {
  id                 String             @id @default(cuid())
  name               String             @unique
  description        String
  muscleGroup        MuscleGroup
  durationWeeks      Int
  sessionsPerWeek    Int
  difficulty         String?
  tier               PlanTier           @default(FREE)
  imageUrl           String?
  videoUrl           String?
  sessionDurationMin String?
  templateType       TemplateType?
  identityTarget     Identity?
  goalTarget         PrimaryGoal?
  environmentTarget  EnvironmentTarget?
  impactLevel        ImpactLevel?
  sexTarget          SexTarget?
  collection         String?
  equipmentId        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  instances          PlanInstance[]
  plannedSessions    PlannedSession[]
  equipment          Equipment?         @relation(fields: [equipmentId], references: [id])
  gymStyleTarget  GymTrainingStyle?

  @@index([equipmentId])
  @@index([goalTarget])
  @@index([environmentTarget])
  @@index([sexTarget])
  @@map("workout_plans")
}

model PlannedSession {
  id               String            @id @default(cuid())
  sessionNumber    Int
  dayOfWeek        Int? // 0=Monday..6=Sunday. Null = legacy sequential fill (backward compatible with plans seeded before this field existed); set = exact day placement, enabling gaps like a mid-week rest day that sequential fill can't represent.
  focus            String
  estimatedMinutes Int               @default(45)
  planId           String
  plannedExercises PlannedExercise[]
  plan             WorkoutPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sessionNumber])
  @@index([planId])
  @@map("planned_sessions")
}

model PlannedExercise {
  id          String         @id @default(cuid())
  order       Int
  sessionId   String
  exerciseId  String
  repsScheme  Int[] // one rep count per set, in order, e.g. [12,12] = 2 sets of 12, [15,12,10] = a 3-set descending pyramid. Array length IS the set count — no separate sets field. Plans are level-specific (via WorkoutPlan.difficulty), so this holds the scheme for that plan's level only, not three parallel tiers.
  restSeconds Int
  exercise    Exercise       @relation(fields: [exerciseId], references: [id])
  session     PlannedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  loggedSets  WorkoutLog[]

  @@unique([sessionId, order])
  @@index([sessionId])
  @@index([exerciseId])
  @@map("planned_exercises")
}

model RecoveryLog {
  id             String   @id @default(cuid())
  loggedAt       DateTime @default(now())
  sleepHours     Float?
  sleepQuality   Int?
  muscleSoreness Int?
  stressLevel    Int?
  recoveryPct    Int
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, loggedAt])
  @@map("recovery_logs")
}

model PlanInstance {
  id                 String           @id @default(cuid())
  level              UserLevel
  status             InstanceStatus   @default(ACTIVE)
  currentSession     Int              @default(1)
  startedAt          DateTime         @default(now())
  completedAt        DateTime?
  sessionDraft       Json?
  userId             String
  planId             String
  progressionType    ProgressionType?
  progressionWeek    Int?
  currentSets        Int?
  currentReps        Int?
  currentRestSeconds Int?
  deloadFlagged      Boolean          @default(false)
  identityAtStart    Identity?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  plan               WorkoutPlan      @relation(fields: [planId], references: [id])
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutLogs        WorkoutLog[]
  

  @@index([userId, status])
  @@index([userId])
  @@map("plan_instances")
}

// WorkoutLog

model WorkoutLog {
  id                String          @id @default(cuid())
  sessionNumber     Int
  completedAt       DateTime        @default(now())
  weightKg          Float?
  actualReps        Int?
  actualSets        Int?
  userId            String
  instanceId        String
  plannedExerciseId String
  createdAt         DateTime        @default(now())
  instance          PlanInstance    @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  plannedExercise   PlannedExercise @relation(fields: [plannedExerciseId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([instanceId])
  @@index([userId, plannedExerciseId])
  @@index([instanceId, sessionNumber])
  @@map("workout_logs")
}

model Subscription {
  id              String    @id @default(uuid())
  plan            Plan      @default(FREE)
  status          String
  source          String?
  startedAt       DateTime  @default(now())
  expiresAt       DateTime?

  payfastToken    String?   @unique
  nextBillingDate DateTime?
  cancelledAt     DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UserEquipment {
  id             String          @id @default(uuid())
  source         EquipmentSource
  addedAt        DateTime        @default(now())
  trialExpiresAt DateTime?
  userId         String
  equipmentId    String
  equipment      Equipment       @relation(fields: [equipmentId], references: [id])
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, equipmentId])
  @@index([userId])
  @@index([equipmentId])
  @@map("user_equipment")
}

model PendingEntitlement {
  id          String    @id @default(uuid())
  email       String
  equipmentId String
  source      String
  createdAt   DateTime  @default(now())
  claimedAt   DateTime?
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@unique([email, equipmentId])
  @@index([email])
  @@map("pending_entitlement")
}

model ProductEquipmentMap {
  id             String    @id @default(uuid())
  storeProductId String    @unique
  equipmentId    String
  equipment      Equipment @relation(fields: [equipmentId], references: [id])

  @@map("product_equipment_map")
}

model CheckoutSession {
  id  String @id @default(uuid())
  fields Json
  actionUrl String
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt DateTime?

  @@map("checkout_sessions")
}


// NOTIFICATION SYSTEM 

model NotificationPreference {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken              String?
  notificationsEnabled   Boolean   @default(true)

  timezone               String    @default("Africa/Johannesburg")
  bedtimeLocal           String    @default("22:00")   // "HH:mm", 24h local time

  // Learned behavior — updated over time as the user trains
  avgSessionStartMinutes Int?      // EMA of minutes-since-midnight when they actually start sessions
  lastAppOpenAt          DateTime?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}


model ScheduledNotification {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          NotificationType
  tier          IdentityTier
  title         String
  body          String

  scheduledFor  DateTime          // planner decides WHEN today this should fire
  status        ScheduleStatus    @default(PENDING)
  sentAt        DateTime?

  createdAt     DateTime          @default(now())

  @@index([status, scheduledFor])
  @@index([userId, createdAt])
}


model NotificationLog {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  tier        IdentityTier
  title       String
  body        String

  sentAt      DateTime          @default(now())
  actioned    Boolean           @default(false)   // did a session get completed after this fired?
  actionedAt  DateTime?

  @@index([userId, sentAt])
  @@index([userId, type, sentAt])
}




enum Role {
  ATHLETE
  COACH
  ADMIN
}

enum SexTarget {
  MALE
  FEMALE
  ANY
}

enum PrimaryGoal {
  LOSE_WEIGHT
  BUILD_MUSCLE
  GET_FIT
}

enum TrainingLocation {
  HOME
  GYM
}

enum BiologicalSex {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum Plan {
  FREE
  EQUIPMENT
  PRO
}

enum EquipmentSource {
  PURCHASED
  DECLARED
  BODYWEIGHT
}

enum MuscleGroup {
  UPPER
  LOWER
  CORE
  FULLBODY
}

enum PlanTier {
  FREE
  EQUIPMENT
  PRO
}

enum UserLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InstanceStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum Identity {
  REBUILD
  OPERATOR
  EXECUTIVE_PERFORMANCE
}

enum TemplateType {
  FAT_LOSS_HOME_BEGINNER
  FAT_LOSS_HOME_INTERMEDIATE
  FAT_LOSS_HOME_ADVANCED
  FAT_LOSS_GYM_BEGINNER
  FAT_LOSS_GYM_INTERMEDIATE
  FAT_LOSS_GYM_ADVANCED
  MUSCLE_HOME_BEGINNER
  MUSCLE_HOME_INTERMEDIATE
  MUSCLE_HOME_ADVANCED
  MUSCLE_GYM_BEGINNER
  MUSCLE_GYM_INTERMEDIATE
  MUSCLE_GYM_ADVANCED
  FUNCTIONAL_HOME_BEGINNER
  FUNCTIONAL_HOME_INTERMEDIATE
  FUNCTIONAL_HOME_ADVANCED
  FUNCTIONAL_GYM_BEGINNER
  FUNCTIONAL_GYM_INTERMEDIATE
  FUNCTIONAL_GYM_ADVANCED
  CROSSFIT_GYM_ADVANCED
  FUNCTIONAL_HOME_RECOVERY
}

enum EnvironmentTarget {
  HOME_BODYWEIGHT
  HOME_EQUIPMENT
  GYM
  ANY
}

enum ProgressionType {
  VOLUME
  LOAD
  DENSITY
}

enum ImpactLevel {
  LOW
  MEDIUM
  HIGH
}


enum GymTrainingStyle {   
  BODYWEIGHT
  CALISTHENICS
  WEIGHTS_AND_MACHINES
  WEIGHTS_ONLY
}



// NOTIFICATION SYSTEM 

enum NotificationType {
  DAILY_HABIT
  STREAK_SAVER
  RECOVERY_READY
  RECOVERY_NUDGE
  RESCHEDULE_SUGGESTION
  MILESTONE
}

enum IdentityTier {
  REBUILD
  OPERATOR
  EXECUTIVE
}

enum ScheduleStatus {
  PENDING
  SENT
  SUPPRESSED
  CANCELLED
}


