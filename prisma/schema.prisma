generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"

}

datasource db {
  provider  = "postgresql"

}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ATHLETE
  COACH
  ADMIN
}

enum PrimaryGoal {
  LOSE_WEIGHT
  BUILD_MUSCLE
  GET_FIT
}

enum TrainingLocation {
  HOME
  GYM
}

enum BiologicalSex {   
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum Plan {
  FREE
  EQUIPMENT
  PRO
}

enum EquipmentSource {
  PURCHASED
  DECLARED
  BODYWEIGHT
}

enum MuscleGroup {
  UPPER
  LOWER
  CORE
  FULLBODY
}

enum PlanTier {
  FREE
  EQUIPMENT
  PRO
}

enum UserLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InstanceStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}


enum Identity {
  REBUILD
  OPERATOR
  EXECUTIVE_PERFORMANCE
}

enum TemplateType {
  FULL_BODY_RESTORE
  FULL_BODY_STRENGTH
  CONDITIONING_CIRCUIT
  PUSH_PULL_LEGS
  ADVANCED_PPL
  STRENGTH_HIIT
  PERFORMANCE_CONDITIONING
}

enum EnvironmentTarget {
  HOME_BODYWEIGHT
  HOME_EQUIPMENT
  GYM
  ANY
}

enum ProgressionType {
  VOLUME
  LOAD
  DENSITY
}

enum ImpactLevel {
  LOW
  MEDIUM
  HIGH
}



// ─────────────────────────────────────────────
// AUTH LAYER
// ─────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String?
  password           String?
  emailVerified      DateTime?
  image              String?
  role               Role      @default(ATHLETE)
  lastLoginAt        DateTime?
  onboardingComplete Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  isNewUser         Boolean   @default(true)
  identity          Identity?
  identityAssignedAt  DateTime?
  primaryGoal   PrimaryGoal?
  trainingLocation TrainingLocation?
  biologicalSex BiologicalSex?
  experienceLevel UserLevel?
  onboardingCompletedAt DateTime?

  accounts      Account[]
  sessions      NextAuthSession[]
  subscription  Subscription?
  userEquipment UserEquipment[]
  instances     PlanInstance[]
  workoutLogs   WorkoutLog[]
  recoveryLogs  RecoveryLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
   @@index([userId])
  @@map("accounts")
}

model NextAuthSession {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])

  
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// EQUIPMENT
// ─────────────────────────────────────────────

model Equipment {
  id        String @id @default(uuid())
  name      String @unique
  category  String // "fullbody" | "upper" | "lower" | "core"

  userEquipment UserEquipment[]
   exercises     ExerciseEquipment[]
  workoutPlans  WorkoutPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("equipment")
}

// ─────────────────────────────────────────────
// EXERCISE LIBRARY
// ─────────────────────────────────────────────

model Exercise {
  id            String  @id @default(uuid())
  name          String  @unique
  description   String?
  youtubeUrl    String?
  musclesWorked String[] 
  muscleGroup   MuscleGroup

  equipmentId String?
  


  impactLevel ImpactLevel @default(MEDIUM)
  isBodyweight Boolean @default(false)
  thumbnailUrl String?
  videoUrl     String?

  equipment ExerciseEquipment[]
  substitutions ExerciseSubstitution[] @relation("OriginalExercise")
  substitutionsFor ExerciseSubstitution[] @relation("SubstituteExercise")
  plannedExercises PlannedExercise []
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentId]) 
  @@map("exercises")
}

model ExerciseEquipment {
  exerciseId String
  equipmentId String
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)


  @@id([exerciseId, equipmentId])
  @@map("exercise_equipment")
}

model ExerciseSubstitution {
  id String @id @default(cuid())
  originalExerciseId String
  substituteExerciseId String
  reason String

  originalExercise Exercise @relation("OriginalExercise", fields: [originalExerciseId], references: [id])
  substituteExercise Exercise @relation("SubstituteExercise", fields: [substituteExerciseId], references: [id])

  @@unique([originalExerciseId, substituteExerciseId])
  @@index([originalExerciseId])
  @@map("exercise_substitutions")
}



// ─────────────────────────────────────────────
// WORKOUT PLAN
// ─────────────────────────────────────────────

model WorkoutPlan {
  id              String      @id @default(cuid())
  name            String      @unique
  description     String
  muscleGroup     MuscleGroup
  durationWeeks   Int
  sessionsPerWeek Int
  difficulty      String?
  tier            PlanTier    @default(FREE)
  imageUrl        String?
  videoUrl        String?
  sessionDurationMin String? 
  templateType TemplateType?
 identityTarget  Identity?
 goalTarget  PrimaryGoal?
  environmentTarget EnvironmentTarget?
  impactLevel ImpactLevel?


  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])

  plannedSessions PlannedSession[]
  instances       PlanInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentId])
  @@map("workout_plans")
}

// ─────────────────────────────────────────────
// PLANNED SESSION
// ─────────────────────────────────────────────

model PlannedSession {
  id            String @id @default(cuid())
  sessionNumber Int
  focus         String
  estimatedMinutes Int @default(45)

  planId String
  plan   WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  plannedExercises PlannedExercise[]

  @@unique([planId, sessionNumber])
   @@index([planId])
  @@map("planned_sessions")
}

// ─────────────────────────────────────────────
// PLANNED EXERCISE
// ─────────────────────────────────────────────

model PlannedExercise {
  id    String @id @default(cuid())
  order Int

  sessionId String
  session   PlannedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  beginnerSets     Int
  beginnerReps     Int
  intermediateSets Int
  intermediateReps Int
  advancedSets     Int
  advancedReps     Int
  restSeconds      Int

  loggedSets WorkoutLog[]

  @@unique([sessionId, order])
    @@index([sessionId])
  @@index([exerciseId])
  @@map("planned_exercises")
}


// ─────────────────────────────────────────────
// RECOVERY LOG
// ─────────────────────────────────────────────

model RecoveryLog {
  id  String @id @default(cuid())
  loggedAt  DateTime @default(now())
  sleepHours Float?
  sleepQuality   Int? 
  muscleSoreness Int?
  stressLevel Int?
  recoveryPct Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, loggedAt])
  @@map("recovery_logs")
}




// ─────────────────────────────────────────────
// PLAN INSTANCE
// ─────────────────────────────────────────────

model PlanInstance {
  id             String         @id @default(cuid())
  level          UserLevel
  status         InstanceStatus @default(ACTIVE)
  currentSession Int            @default(1)
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  sessionDraft   Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String
  plan   WorkoutPlan @relation(fields: [planId], references: [id])
  workoutLogs WorkoutLog[]
  progressionType ProgressionType?
  progressionWeek Int?
  currentSets Int?
  currentReps Int?
  currentRestSeconds Int?
  deloadFlagged Boolean @default(false)
  identityAtStart Identity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId])

  @@map("plan_instances")
}

// ─────────────────────────────────────────────
// WORKOUT LOG
// ─────────────────────────────────────────────

model WorkoutLog {
  id            String   @id @default(cuid())
  sessionNumber Int
  completedAt   DateTime @default(now())

  weightKg   Float?
  actualReps Int?
  actualSets Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  instanceId String
  instance   PlanInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  plannedExerciseId String
  plannedExercise   PlannedExercise @relation(fields: [plannedExerciseId], references: [id])

  createdAt DateTime @default(now())
  @@index([userId])
  @@index([instanceId])
  @@index([userId, plannedExerciseId])
 @@index([instanceId, sessionNumber])
  @@map("workout_logs")
}

// ─────────────────────────────────────────────
// SUBSCRIPTION
// ─────────────────────────────────────────────

model Subscription {
  id        String   @id @default(uuid())
  plan      Plan     @default(FREE)
  status    String
  source    String?
  startedAt DateTime @default(now())
  expiresAt DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─────────────────────────────────────────────
// USER EQUIPMENT
// ─────────────────────────────────────────────

model UserEquipment {
  id      String          @id @default(uuid())
  source  EquipmentSource
  addedAt DateTime        @default(now())
  trialExpiresAt DateTime? // only set when source = DECLARED

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
   @@index([userId])

  @@index([equipmentId])
  @@map("user_equipment")
}
